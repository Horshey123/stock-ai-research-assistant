# 将此文件复制为项目根目录的 .env.server，然后填写真实值。
# 不要把 .env.server 上传到代码仓库，也不要把密钥发到聊天中。

DEEPSEEK_API_KEY=请替换为你的新密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 防止公网用户直接调用接口消耗你的 AI 额度。
# 在服务器执行：python3 -c "import secrets; print(secrets.token_hex(32))"
# 将输出内容填到等号后面。
STOCK_AI_API_TOKEN=请替换为随机生成的64位字符
