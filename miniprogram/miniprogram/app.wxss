page {
  min-height: 100%;
  background: #f4f7f6;
  color: #17211e;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 18rpx;
  font-size: 30rpx;
  font-weight: 600;
}

button::after {
  border: none;
}

.page {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e4ebe8;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 34rpx rgba(11, 59, 46, 0.06);
}
