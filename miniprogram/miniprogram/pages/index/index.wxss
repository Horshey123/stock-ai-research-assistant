.home-page {
  padding-bottom: 56rpx;
}

.hero {
  margin: -32rpx -32rpx 28rpx;
  padding: 54rpx 40rpx 72rpx;
  color: #ffffff;
  background:
    radial-gradient(circle at 88% 12%, rgba(110, 231, 183, 0.24), transparent 34%),
    linear-gradient(145deg, #082e24, #0b563f);
  border-radius: 0 0 40rpx 40rpx;
}

.eyebrow {
  margin-bottom: 18rpx;
  color: #8de1c1;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.hero-title {
  width: 570rpx;
  font-size: 50rpx;
  font-weight: 750;
  line-height: 1.28;
}

.hero-subtitle {
  width: 590rpx;
  margin-top: 20rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 27rpx;
  line-height: 1.7;
}

.service-pill {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 30rpx;
  padding: 12rpx 18rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  font-size: 23rpx;
}

.service-dot {
  width: 13rpx;
  height: 13rpx;
  background: #f2c94c;
  border-radius: 50%;
}

.service-pill.online .service-dot {
  background: #6ee7b7;
  box-shadow: 0 0 0 7rpx rgba(110, 231, 183, 0.12);
}

.service-pill.offline .service-dot {
  background: #ff8b8b;
}

.search-card {
  position: relative;
  z-index: 2;
  margin-top: -56rpx;
  padding: 32rpx;
}

.section-label {
  margin-bottom: 16rpx;
  color: #52615c;
  font-size: 24rpx;
  font-weight: 600;
}

.input-row {
  display: flex;
  align-items: center;
  height: 100rpx;
  padding: 0 24rpx;
  background: #f6f9f8;
  border: 2rpx solid #dce7e3;
  border-radius: 18rpx;
}

.code-input {
  flex: 1;
  height: 100%;
  color: #0b3b2e;
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 5rpx;
}

.input-placeholder {
  color: #a8b4b0;
  font-size: 30rpx;
  font-weight: 400;
  letter-spacing: 0;
}

.digit-count {
  color: #91a09b;
  font-size: 23rpx;
}

.example-row {
  display: flex;
  gap: 12rpx;
  margin: 20rpx 0 30rpx;
  overflow-x: auto;
}

.example-chip {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 14rpx 18rpx;
  color: #4b5e57;
  background: #f2f6f4;
  border: 1rpx solid transparent;
  border-radius: 14rpx;
  font-size: 24rpx;
}

.example-chip.selected {
  color: #07563f;
  background: #e5f6ef;
  border-color: #a6dcc8;
}

.example-code {
  color: #82918c;
  font-size: 20rpx;
}

.refresh-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid #edf1ef;
}

.refresh-title {
  font-size: 26rpx;
  font-weight: 600;
}

.refresh-desc {
  margin-top: 7rpx;
  color: #899690;
  font-size: 21rpx;
}

.primary-button {
  height: 94rpx;
  margin-top: 16rpx;
  color: #ffffff;
  line-height: 94rpx;
  background: linear-gradient(135deg, #0b7a5a, #07513d);
  box-shadow: 0 12rpx 24rpx rgba(11, 122, 90, 0.2);
}

.primary-button[disabled] {
  color: rgba(255, 255, 255, 0.75);
  background: #6d9d8f;
}

.secondary-button {
  height: 84rpx;
  margin-top: 18rpx;
  color: #0b684e;
  line-height: 84rpx;
  background: #edf8f4;
}

.feature-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.feature-item {
  flex: 1;
  padding: 24rpx 18rpx;
}

.feature-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 54rpx;
  height: 54rpx;
  margin-bottom: 18rpx;
  color: #0b7355;
  background: #e4f5ee;
  border-radius: 15rpx;
  font-size: 24rpx;
  font-weight: 700;
}

.feature-title {
  font-size: 26rpx;
  font-weight: 650;
}

.feature-desc {
  margin-top: 8rpx;
  color: #89958f;
  font-size: 20rpx;
  line-height: 1.5;
}

.notice {
  margin-top: 30rpx;
  padding: 0 24rpx;
  color: #93a09b;
  font-size: 21rpx;
  line-height: 1.6;
  text-align: center;
}
