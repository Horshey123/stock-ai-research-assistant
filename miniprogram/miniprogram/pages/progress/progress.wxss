.progress-page {
  padding-bottom: 50rpx;
}

.progress-hero {
  margin: -32rpx -32rpx 28rpx;
  padding: 56rpx 40rpx 52rpx;
  color: #ffffff;
  background: linear-gradient(145deg, #082e24, #0b6247);
  border-radius: 0 0 40rpx 40rpx;
}

.stock-code {
  color: #87d8ba;
  font-size: 24rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.status-title {
  margin-top: 20rpx;
  font-size: 44rpx;
  font-weight: 750;
}

.status-message {
  min-height: 78rpx;
  margin-top: 16rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 25rpx;
  line-height: 1.6;
}

.progress-track {
  height: 14rpx;
  margin-top: 30rpx;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #5ee6b2, #b0f5da);
  border-radius: 999rpx;
  transition: width 0.4s ease;
}

.progress-number {
  margin-top: 12rpx;
  color: #a8eed4;
  font-size: 24rpx;
  text-align: right;
}

.steps-card {
  padding: 32rpx 30rpx 12rpx;
}

.card-title {
  margin-bottom: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.step-row {
  display: flex;
  min-height: 112rpx;
}

.step-rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 52rpx;
  margin-right: 18rpx;
}

.step-dot {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  width: 30rpx;
  height: 30rpx;
  color: #ffffff;
  background: #d6dfdb;
  border: 6rpx solid #f1f5f3;
  border-radius: 50%;
  font-size: 19rpx;
}

.step-line {
  flex: 1;
  width: 3rpx;
  background: #e2e9e6;
}

.step-content {
  padding-bottom: 26rpx;
}

.step-title {
  color: #7d8b86;
  font-size: 27rpx;
  font-weight: 650;
}

.step-desc {
  margin-top: 7rpx;
  color: #a0aba7;
  font-size: 22rpx;
}

.step-row.done .step-dot,
.step-row.active .step-dot {
  background: #0b7a5a;
  border-color: #d8f2e8;
}

.step-row.done .step-line {
  background: #89cbb3;
}

.step-row.done .step-title,
.step-row.active .step-title {
  color: #133c30;
}

.step-row.active .step-dot {
  box-shadow: 0 0 0 8rpx rgba(11, 122, 90, 0.1);
}

.error-card {
  margin-top: 24rpx;
  padding: 24rpx;
  color: #8b332f;
  background: #fff1ef;
  border: 1rpx solid #f2c6c2;
  border-radius: 18rpx;
}

.error-title {
  font-weight: 700;
}

.error-text {
  margin-top: 10rpx;
  font-size: 23rpx;
  line-height: 1.6;
}

.button-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.retry-button,
.home-button {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
}

.retry-button {
  color: #ffffff;
  background: #0b7255;
}

.home-button {
  color: #285246;
  background: #e7efec;
}

.waiting-tip {
  padding: 30rpx 18rpx 0;
  color: #91a09b;
  font-size: 22rpx;
  line-height: 1.6;
  text-align: center;
}
