# Local configuration for the double-click launcher.
# Keep the real .env.local file private.

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# Optional for localhost-only use. Add a random token before exposing the API.
STOCK_AI_API_TOKEN=

# Keep 127.0.0.1 unless another device on your LAN must access this computer.
STOCK_AI_HOST=127.0.0.1
STOCK_AI_PORT=8000
